<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      monaka（sideload 専用 / Google Play 非公開）の権限セット。

      全ファイルアクセス（Android 11+ の MANAGE_EXTERNAL_STORAGE）を使い、ユーザー権限で
      読み書きできる共有ストレージ全体を Linux コンテナへ直接 bind mount する。
      これは Play の制限付き権限だが、GitHub/直配布のみで公開しないため使用できる。

      Android 10 以下（API 30 未満）では MANAGE_EXTERNAL_STORAGE が無いため、
      従来の READ/WRITE_EXTERNAL_STORAGE + requestLegacyExternalStorage で全体アクセスする。
      maxSdkVersion="29" を付け、11+ では自動的に無視させる。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      バックグラウンド実行の維持。
      ターミナルの PTY(= PRoot 配下の Linux プロセス群)をフォアグラウンドサービスに
      所有させ、アプリが背面に回ってもキャッシュ済みプロセスへ落とされないようにする。
      これがないと Android 12+ の phantom process killer / Doze により、
      claude や長時間ビルドがバックグラウンドで停止する。

      - FOREGROUND_SERVICE / _DATA_SYNC: 常駐サービスの実行(Android 9+/14+)
      - POST_NOTIFICATIONS: 実行中を示す通知の表示(Android 13+ は実行時許可)
      - WAKE_LOCK: Doze 中も PTY 配下の処理が止まらないようにする
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          PTY セッションを Activity の寿命から切り離して保持するフォアグラウンドサービス。
          これによりホームに戻る/他アプリへ切り替えても Linux 側の処理が走り続ける。
          foregroundServiceType=dataSync は Android 14+ で必須の種別宣言。
        -->
        <service
            android:name=".TerminalSessionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          singleTop: 通知タップでの復帰時に、既存のターミナル画面をもう一枚積まず
          onNewIntent で再利用する。singleTask にすると新しいタスクのルートになり
          MainActivity への戻り導線が壊れるため使わない。
        -->
        <activity
            android:name=".EmbeddedTerminalActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity
            android:name=".ContainerManagerActivity"
            android:exported="false" />

        <activity
            android:name=".StorageSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <activity
            android:name=".LegalActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
