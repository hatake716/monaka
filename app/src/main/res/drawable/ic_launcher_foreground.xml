<?xml version="1.0" encoding="utf-8"?>
<!--
  monaka ランチャーアイコン（前景）。
  最中(もなか): きつね色に焼けた皮 + 小豆(あずき)の餡。
  皮の面に開発ターミナルの `>_` を小豆色で置く。
  adaptive-icon のセーフゾーン(中央 66dp 径, viewport 108)内に収める。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 餡(小豆)の層。皮の間からのぞく餡。濃い小豆色。 -->
    <path android:fillColor="#7A3B2E"
        android:pathData="M30,54 Q30,50 34,50 L74,50 Q78,50 78,54 L78,58 Q78,62 74,62 L34,62 Q30,62 30,58 Z" />
    <!-- 餡のつや(明るい小豆色) -->
    <path android:fillColor="#9C4A3C"
        android:pathData="M33,53 L75,53 L75,56 L33,56 Z" />

    <!-- 上の皮(最中種)。きつね色に焼けたクリーム。丸みのあるドーム。 -->
    <path android:fillColor="#D69E7A"
        android:pathData="M26,50 Q26,33 54,33 Q82,33 82,50 Z" />
    <!-- 上の皮の焼き色ハイライト -->
    <path android:fillColor="#E8C4A0"
        android:pathData="M32,47 Q34,38 54,37 Q74,38 76,47 Z" />

    <!-- 下の皮(最中種)。 -->
    <path android:fillColor="#C98A66"
        android:pathData="M26,62 L82,62 Q82,79 54,79 Q26,79 26,62 Z" />
    <!-- 下の皮の陰影 -->
    <path android:fillColor="#B0764F"
        android:pathData="M30,70 Q40,76 54,76 Q68,76 78,70 L78,73 Q68,78 54,78 Q40,78 30,73 Z" />

    <!-- 最中の型押し模様(上の皮): 格子のドット -->
    <path android:fillColor="#B0764F"
        android:pathData="M40,42 m-1.3,0 a1.3,1.3 0,1 0,2.6 0 a1.3,1.3 0,1 0,-2.6 0
                          M54,40 m-1.3,0 a1.3,1.3 0,1 0,2.6 0 a1.3,1.3 0,1 0,-2.6 0
                          M68,42 m-1.3,0 a1.3,1.3 0,1 0,2.6 0 a1.3,1.3 0,1 0,-2.6 0" />

    <!-- ターミナルの `>_` を下の皮の面に小豆色で。開発ツールであることを示す。 -->
    <path android:strokeColor="#7A3B2E" android:strokeWidth="3.4"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M40,66 L46,70 L40,74" />
    <path android:strokeColor="#7A3B2E" android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:pathData="M51,74 L62,74" />
</vector>
