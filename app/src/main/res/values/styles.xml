<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      monaka: iOS 27 風。温かいオフホワイト地 + 暗いステータスバーアイコン。
      面の質感（連続曲率・拡散光・極細の縁）は IosSurface がコードで描くが、
      システムが出すダイアログだけはテーマで寄せる。
    -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:alertDialogTheme">@style/AppTheme.Dialog</item>
    </style>

    <!--
      iOS のアラート風。角丸を大きく取り、ボタンはアクセント色の文字にする。
      （iOS のアラートは面が白く、操作は色付きの文字で示される）
    -->
    <style name="AppTheme.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
